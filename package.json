{
  "name": "melges-landing-workspace",
  "private": true,
  "scripts": {
    "dev": "npm --prefix ./melges-landing run dev",
    "build": "npm --prefix ./melges-landing run build",
    "preview": "npm --prefix ./melges-landing run preview",
    "server": "node ./server/src/index.js",
    "start": "node ./server/src/index.js",
    "migrate": "node ./server/src/migrate.js",
    "start:all": "node ./node_modules/concurrently/dist/bin/index.js -n api,site -c blue,magenta \"npm run server\" \"npm run dev\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase": "^12.19.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.2",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
